    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/vite-plugin": "1.52.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.1",
